<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui1.helloUdAlfPage"
             BackgroundColor="Black"
             Title="helloUdAlfPage">
    <VerticalStackLayout>
        <Label 
            Text="My name is Amit"
            FontSize="40"
            TextColor="Black"
            BackgroundColor="Wheat"
            VerticalOptions="Center" 
            HorizontalOptions="Start" />
        <HorizontalStackLayout>
            <Image Source="dotnet_bot.png" HeightRequest="150" HorizontalOptions="Start" WidthRequest="150"/>
            <Image Source="dotnet_bot.png" HeightRequest="150" HorizontalOptions="End" WidthRequest="150"/>
            <Entry />
            <Button Text="hi" BackgroundColor="LightBlue" HorizontalOptions="Center" VerticalOptions="Center"/>
        </HorizontalStackLayout>
        <Label 
            Text="hello world! shalom"
            FontSize="40"
            TextColor="Black"
            BackgroundColor="White"
            VerticalOptions="Center" 
            HorizontalOptions="Start" />
    </VerticalStackLayout>
</ContentPage>